# Azure App Registration Credentials
# Get these from Azure Portal > Azure Active Directory > App registrations

# Your Azure App (client) ID
AZURE_CLIENT_ID=12345678-1234-1234-1234-123456789012

# Your Azure Tenant (directory) ID
AZURE_TENANT_ID=87654321-4321-4321-4321-210987654321

# Your Azure App Client Secret
# WARNING: Keep this secret! Never commit to version control
AZURE_CLIENT_SECRET=abc~def.123xyz_ABC-XYZ_123456789.abcdefg
